---
/**
 * 核心功能：M1/M2/M3/M5 精选 4 个模块
 * - M4/M6 折叠为「即将上线」
 */
const features = [
  {
    name: '智能诊断',
    desc: '你只需回答几个问题，AI 自动帮你找准作品定位、目标人群、一句话卖点——再也不用"我不知道怎么介绍"。',
    badge: '已上线',
    icon: 'stethoscope',
  },
  {
    name: '物料生成',
    desc: '3 分钟拿到 13 个平台的专属文案、海报、演示视频、落地页——零设计基础、零剪辑经验，也能做出专业感。',
    badge: '已上线',
    icon: 'sparkles',
  },
  {
    name: '72h 发布计划',
    desc: 'AI 给你排好逐日逐渠道的发布节奏，什么时间发什么平台一目了然——你只需按一下「发布」。',
    badge: '已上线',
    icon: 'calendar',
  },
  {
    name: '数据看板',
    desc: '本机会话发布次数 / 渠道分布 / 里程碑报喜，全部基于本机真实数据回填。1.5 起接入各平台官方统计 API。',
    badge: '已上线',
    icon: 'chart',
  },
  {
    name: '反馈采集 + AI 分析',
    desc: '每日抓取评论与评分，AI 帮你归类总结，输出 P0/P1/P2 迭代清单——不用一条条翻评论。',
    badge: 'MVP 1.5',
    icon: 'message',
  },
  {
    name: '社区与资源库',
    desc: '成功案例库、工具推荐榜单、成长路径——看看别人是怎么做的，少走弯路。',
    badge: 'MVP 2.0',
    icon: 'users',
  },
];
---

<section class="section features" id="features">
  <div class="container">
    <header class="section-head">
      <span class="eyebrow">CORE FEATURES</span>
      <h2>六大模块，<span class="highlight">让推广不再卡住你</span></h2>
      <p>不用再为推广发愁——从文案到数据，每一步都有 AI 帮你。</p>
    </header>

    <div class="features-grid">
      {features.map((f) => (
        <article class={`card feat ${f.badge !== '已上线' ? 'feat-soon' : ''}`}>
          <header class="feat-head">
            <span class={`feat-badge ${f.badge === '已上线' ? 'on' : 'soon'}`}>{f.badge}</span>
          </header>

          <div class="feat-icon" aria-hidden="true">
            {f.icon === 'stethoscope' && (
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M11 2v2"/>
                <path d="M5 2v2"/>
                <path d="M5 3H4a2 2 0 0 0-2 2v4a6 6 0 0 0 12 0V5a2 2 0 0 0-2-2h-1"/>
                <path d="M8 15a6 6 0 0 0 12 0v-3"/>
                <circle cx="20" cy="10" r="2"/>
              </svg>
            )}
            {f.icon === 'sparkles' && (
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="m12 3-1.9 5.8L4 10l5.8 1.9L12 18l1.9-5.8L20 10l-6.1-1.9L12 3z"/>
                <path d="M5 3v4"/>
                <path d="M19 17v4"/>
                <path d="M3 5h4"/>
                <path d="M17 19h4"/>
              </svg>
            )}
            {f.icon === 'calendar' && (
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <rect x="3" y="4" width="18" height="18" rx="2"/>
                <line x1="16" y1="2" x2="16" y2="6"/>
                <line x1="8" y1="2" x2="8" y2="6"/>
                <line x1="3" y1="10" x2="21" y2="10"/>
              </svg>
            )}
            {f.icon === 'chart' && (
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <line x1="12" y1="20" x2="12" y2="10"/>
                <line x1="18" y1="20" x2="18" y2="4"/>
                <line x1="6" y1="20" x2="6" y2="16"/>
                <line x1="3" y1="20" x2="21" y2="20"/>
              </svg>
            )}
            {f.icon === 'message' && (
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/>
              </svg>
            )}
            {f.icon === 'users' && (
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/>
                <circle cx="9" cy="7" r="4"/>
                <path d="M23 21v-2a4 4 0 0 0-3-3.87"/>
                <path d="M16 3.13a4 4 0 0 1 0 7.75"/>
              </svg>
            )}
          </div>

          <h3>{f.name}</h3>
          <p>{f.desc}</p>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .features-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 20px;
  }

  .feat {
    position: relative;
    display: flex;
    flex-direction: column;
  }

  .feat-head {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    margin-bottom: 18px;
  }

  .feat-badge {
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.05em;
    padding: 2px 8px;
    border-radius: 999px;
  }

  .feat-badge.on {
    background: rgba(31, 156, 154, 0.2);
    color: var(--primary-glow);
    border: 1px solid var(--primary-glow);
  }

  .feat-badge.soon {
    background: rgba(148, 212, 208, 0.08);
    color: var(--text-mute);
    border: 1px solid var(--border);
  }

  .feat-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border-radius: 11px;
    background: linear-gradient(135deg, rgba(14, 124, 123, 0.18) 0%, rgba(31, 156, 154, 0.08) 100%);
    border: 1px solid var(--border);
    color: var(--primary-soft);
    margin-bottom: 16px;
    transition: all 0.3s var(--ease);
  }

  .feat-icon svg {
    width: 22px;
    height: 22px;
  }

  .feat:hover .feat-icon {
    background: linear-gradient(135deg, rgba(14, 124, 123, 0.4) 0%, rgba(31, 156, 154, 0.2) 100%);
    color: #fff;
    transform: scale(1.05);
  }

  .feat h3 {
    margin-bottom: 8px;
    font-size: 1.15rem;
  }

  .feat p {
    font-size: 0.92rem;
    line-height: 1.65;
  }

  .feat-soon {
    opacity: 0.65;
  }

  .feat-soon:hover {
    opacity: 1;
  }
</style>
