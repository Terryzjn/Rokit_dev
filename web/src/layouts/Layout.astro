---
/**
 * Rokit 首站全局布局
 * - <html>/<head> 完整 SEO/OG/Twitter meta
 * - 中文 lang，首屏性能预算友好
 */
import '../styles/global.css';

export interface Props {
  title?: string;
  description?: string;
  canonical?: string;
}

const {
  title = 'Rokit · 作品首秀发射台 — 让你的第一个作品被世界看见',
  description = 'Rokit 是开源桌面工具，给独立开发者和学生开发者：从登记作品、AI 生成全套推广物料、到一键分平台发布，全流程由 AI 接管。本地 SQLite，BYOK，零账号。',
  canonical,
} = Astro.props;

const siteUrl = Astro.site?.toString().replace(/\/$/, '') ?? 'https://rokit.vercel.app';
const fullCanonical = canonical ?? `${siteUrl}/`;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#0a0e14" />
    <meta name="color-scheme" content="dark" />

    <!-- SEO -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={fullCanonical} />
    <meta name="keywords" content="Rokit,作品首秀,AI 推广,独立开发者,BYOK,开源桌面应用,V2EX,掘金,小红书" />
    <meta name="author" content="ProClips+" />
    <meta name="robots" content="index,follow" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="zh_CN" />
    <meta property="og:site_name" content="Rokit" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={fullCanonical} />
    <meta property="og:image" content={`${siteUrl}/og-image.png`} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Rokit · 作品首秀发射台" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={`${siteUrl}/og-image.png`} />
    <meta name="twitter:image:alt" content="Rokit · 作品首秀发射台" />
    <meta name="twitter:site" content="@rokit_dev" />
    <meta name="twitter:creator" content="@ProClips" />

    <!-- 图标 -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/favicon.svg" />
    <link rel="sitemap" type="application/xml" href="/sitemap.xml" />

    <!-- 结构化数据：软件应用 -->
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'SoftwareApplication',
      name: 'Rokit',
      applicationCategory: 'DeveloperApplication',
      operatingSystem: 'Windows 10, Windows 11',
      description,
      offers: { '@type': 'Offer', price: '0', priceCurrency: 'CNY' },
      license: 'https://opensource.org/licenses/MIT',
      softwareVersion: '0.1.5',
    })} />
  </head>
  <body>
    <a href="#main-content" class="skip-link">跳到主要内容</a>
    <slot />
  </body>
</html>
